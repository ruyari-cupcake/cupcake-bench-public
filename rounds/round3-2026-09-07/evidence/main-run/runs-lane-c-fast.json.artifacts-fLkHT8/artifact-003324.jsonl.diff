index 63f0d0e..1e73223 100644
--- a/src/summary.js
+++ b/src/summary.js
@@ -1,10 +1,48 @@
-import { catalog } from './catalog.js';
+import { requestJSON } from './http.js';
+
+function ownValue(object, key) {
+  return object && typeof key === 'string' && Object.hasOwn(object, key)
+    ? object[key]
+    : undefined;
+}
+
+function unknownSelection() {
+  return Object.assign(new Error('Unknown selection'), { code: 'UNKNOWN_SELECTION' });
+}
 
 export function createStatement(config) {
-  return { async summary(...args) {
-    const ticket = config.tickets[args[0]];
-    if (!ticket) return null;
-    const { shelf: destination, reader: account } = ticket;
-    return catalog(config).find((row) => row.destination === destination && row.account === account) ?? null;
-  } };
+  return {
+    async summary(ticket) {
+      const selection = ownValue(config.tickets, ticket);
+      if (!selection) throw unknownSelection();
+
+      const { shelf: destination, reader: account } = selection;
+      const shelf = Array.isArray(config.shelves)
+        ? config.shelves.find((entry) => entry?.id === destination)
+        : undefined;
+      const reader = ownValue(config.readers, account);
+      const pass = ownValue(reader?.passes, destination);
+      if (typeof destination !== 'string' || typeof account !== 'string'
+          || !shelf || typeof pass !== 'string') {
+        throw unknownSelection();
+      }
+
+      try {
+        const url = new URL(shelf.statementPrefix + encodeURIComponent(account), shelf.address);
+        const result = await requestJSON(url, { Authorization: `Token ${pass}` });
+        if (!result || result.destination !== destination || result.account !== account
+            || !Number.isFinite(result.units) || typeof result.unit !== 'string') {
+          throw new Error('Invalid statement response');
+        }
+        return {
+          destination: result.destination,
+          account: result.account,
+          units: result.units,
+          unit: result.unit,
+        };
+      } catch (cause) {
+        throw Object.assign(new Error('Statement service unavailable', { cause }), { code: 'UPSTREAM' });
+      }
+    },
+  };
 }
