+    throw upstream();
+  }
+
+  try {
+    const base = service.baseUrl.endsWith('/') ? service.baseUrl.slice(0, -1) : service.baseUrl;
+    const prefix = service.memberPrefix.startsWith('/') ? service.memberPrefix : `/${service.memberPrefix}`;
+    return new URL(`${base}${prefix}${encodeURIComponent(account)}/summary`).toString();
+  } catch {
+    throw upstream();
+  }
