+      if (!resolved) throw errorWithCode('Unknown selection', 'UNKNOWN_SELECTION');
+
+      const url = `${resolved.service.baseUrl}${resolved.service.memberPrefix}${encodeURIComponent(account)}/summary`;
+      let response;
+      try {
+        response = await requestJSON(url, { 'X-Ledger-Key': resolved.profile.key });
