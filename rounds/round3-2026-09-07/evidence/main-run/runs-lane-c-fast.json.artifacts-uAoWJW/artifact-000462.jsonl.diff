+  const legacy = cells[0] === '1' && cells.length === 4;
+  if (!legacy && (cells.length !== WIDTH || cells[0] !== String(VERSION))) throw new Error('Invalid contact');
+  return { id: cells[1], name: cells[2], email: cells[3], group: legacy ? '' : cells[4] };
 }
 
